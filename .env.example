# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=gagik

# Payload CMS Configuration
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# Cloudflare R2 Storage Configuration
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=https://files.yourdomain.com

# Site Configuration (REQUIRED for build)
# This MUST be set as a build-time environment variable in your deployment platform
NEXT_PUBLIC_SITE_URL=https://gagik.mohammaddaryani.dev